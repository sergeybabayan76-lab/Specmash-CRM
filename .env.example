# ==========================================
# СТО Спецмаш CRM — Пример переменных окружения (.env.example)
# Скопируйте этот файл в .env и укажите ваши реальные значения:
# cp .env.example .env
# ==========================================

# База данных Supabase (PostgreSQL)
# URL вашего проекта Supabase (https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Серверный секрет Supabase. Никогда не отдаётся в браузер.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# PostgreSQL-подключение для автоматического создания схемы при первом запуске.
# Возьмите URI из Supabase: Project Settings -> Database -> Connection string -> Session pooler.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Вместо SUPABASE_DB_URL можно указать пароль базы; хост будет собран из SUPABASE_URL.
# SUPABASE_DB_PASSWORD=your_database_password

# Публичный ключ Supabase для Realtime в браузере (anon/publishable key).
# Можно оставить пустым, если Realtime не используется локально.
SUPABASE_PUBLISHABLE_KEY=

# Настройки окружения (development | production)
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
