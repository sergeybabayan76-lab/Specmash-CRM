# Copy this file to .env. Never commit .env or share its values.

# Supabase -> Project Settings -> API
SUPABASE_URL=
# Server-only secret key (sb_secret_...) or legacy service_role JWT.
# Never use a publishable/anon key here; never expose this key in browser code.
SUPABASE_KEY=

# Required when Supabase is configured. Generate a random value of 32+ characters.
APP_SESSION_SECRET=

# Optional: creates the first admin only when public.users is empty.
# Leave both blank to keep the database empty until you create a user manually.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Local development server
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
