# ==========================================
# СТО Спецмаш CRM — Пример переменных окружения (.env.example)
# Скопируйте этот файл в .env и укажите ваши реальные значения:
# cp .env.example .env
# ==========================================

# === Supabase REST API (обязательно для приложения) ===
# Адрес проекта. Используется backend для PostgREST и Realtime config.
SUPABASE_URL=https://your-project-id.supabase.co

# Секретный серверный ключ. Используется backend для чтения/записи CRM.
# Никогда не передавайте этот ключ в браузер и не публикуйте его.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Публичный ключ. Нужен только для клиентского Realtime-конфига.
# Оставьте пустым, если Realtime в браузере не используется.
SUPABASE_PUBLISHABLE_KEY=

# === PostgreSQL DDL/migrations (обязательно для первого запуска) ===
# Прямое подключение к PostgreSQL через Session Pooler (IPv4).
# Используется только init_database.py и автоматической миграцией при старте.
# Возьмите URI: Supabase -> Project Settings -> Database -> Connection string -> Session pooler.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Альтернатива: задайте пароль БД, и URL будет собран автоматически из SUPABASE_URL.
# SUPABASE_DB_PASSWORD=your_database_password

# === Первый администратор (обязательно для чистой базы) ===
# Создаётся один раз; повторный запуск не создаёт дубликат.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_password

# === Локальный сервер (не относится к Supabase) ===
# APP_SESSION_SECRET сейчас не используется приложением.
# SUPABASE_JWKS_URL сейчас не используется приложением.
# DATABASE_URL — совместимый alias для SUPABASE_DB_URL; используйте одно из двух.

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
