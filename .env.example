# ==========================================
# СТО Спецмаш CRM — Пример переменных окружения (.env.example)
# Скопируйте этот файл в .env и укажите ваши реальные значения:
# cp .env.example .env
# ==========================================

# База данных Supabase (PostgreSQL)
# URL вашего проекта Supabase (https://<project-ref>.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Секретный ключ Supabase (Service Role Key или Anon Key)
SUPABASE_KEY=your_supabase_secret_key_here

# Учетные записи по умолчанию для первичной инициализации (если таблица users пуста)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password

DEFAULT_MODERATOR_USERNAME=moderator
DEFAULT_MODERATOR_PASSWORD=your_secure_moderator_password

DEFAULT_MECHANIC_USERNAME=mechanic
DEFAULT_MECHANIC_PASSWORD=your_secure_mechanic_password

# Настройки окружения (development | production)
ENVIRONMENT=production
HOST=127.0.0.1
PORT=8000
