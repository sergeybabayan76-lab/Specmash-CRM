# Docker Compose / Coolify PostgreSQL settings.
POSTGRES_DB=specmash
POSTGRES_USER=specmash
POSTGRES_PASSWORD=replace_with_strong_database_password

# Local run outside Docker. Inside Compose DATABASE_URL is built automatically.
DATABASE_URL=postgresql://specmash:replace_with_strong_database_password@localhost:5432/specmash

# First administrator created on the first startup.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_with_strong_admin_password

# Local HTTP server.
HOST=127.0.0.1
PORT=8000
APP_PORT=8000
